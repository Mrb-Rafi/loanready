# --- runtime ---
LOANREADY_ENV=dev                 # dev | test | demo
LOANREADY_AS_OF=2026-10-14        # business date used by Clock
LOANREADY_TZ=Asia/Dhaka           # display timezone; storage is UTC
LOANREADY_SEED=20261014
LOANREADY_VAR_DIR=var
LOANREADY_FRAMEWORK=IFRS_SME      # IFRS_SME | US_GAAP
LOANREADY_CURRENCY=USD
LOANREADY_UI_FAKE=0               # 1 = UI runs on FakeAppFacade (WP10 development)

# --- sandbox (synthetic tokens; NOT secrets; change freely) ---
SANDBOX_URL=http://127.0.0.1:8100
SANDBOX_READ_TOKEN=sbx-read-dev-0001
SANDBOX_WRITE_TOKEN=sbx-write-dev-0001
SANDBOX_ADMIN_TOKEN=sbx-admin-dev-0001
SANDBOX_MODE=inprocess            # inprocess | external (external = separate `python tasks.py sandbox` process)
SBX_WRITE_RATE_PER_MIN=30
SBX_MAX_PAYMENT_CENTS=500000      # bank-side limits, independent of the app's caps
SBX_DAILY_OUTGOING_CENTS=1000000
BANK_PROVIDER=mock                # mock | plaid (P2, read-only)
POS_PROVIDER=mock                 # mock | square | stripe (P2, read-only)

# --- LLM ---
LLM_BACKEND=mock                  # mock | ollama | openai | hybrid (hybrid = per-task routing, PRD/09 §2.2)
LLM_ROUTES_FILE=                  # optional JSON overriding hybrid routes (validated; cannot bypass the data-class policy)
OLLAMA_TIMEOUT_S=60
OPENAI_TIMEOUT_S=30
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=phi3:mini
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MAX_CALLS=300
OPENAI_MAX_USD=8.00                # per day
OPENAI_TOTAL_MAX_USD=0             # all time, persisted in var/llm_cache.db (0 = off); set below your prepaid credit
OPENAI_PRICE_IN_PER_MTOK=0        # USD per million input tokens (0 = count calls only)
OPENAI_PRICE_OUT_PER_MTOK=0

# --- OCR ---
OCR_BACKEND=auto                  # auto | tesseract | sidecar
TESSERACT_CMD=                    # e.g. C:\Program Files\Tesseract-OCR\tesseract.exe

# --- governance defaults (seeded into settings table; owner can change in UI) ---
CAP_PER_ACTION_CENTS=500000
CAP_PER_DAY_CENTS=1000000
CAP_PER_PAYEE_WEEK_CENTS=800000
CAP_MSGS_PER_CUSTOMER_WEEK=2
APPROVAL_TTL_SECONDS=900
CONFIDENCE_CONFIRM_THRESHOLD=0.80
RECEIPT_CONFIRM_THRESHOLD=0.75
